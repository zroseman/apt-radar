# Required — Anthropic API key for parsing listing text with Claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — Slack incoming webhook for new-listing alerts.
# Leave blank to skip Slack notifications (you'll see matches in the dashboard).
APT_RADAR_SLACK_WEBHOOK=

# Optional — port to bind the dashboard to. Defaults to 5055.
# Useful if you already have something on 5055.
APT_RADAR_PORT=
